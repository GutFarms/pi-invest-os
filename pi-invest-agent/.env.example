# Copy to .env and fill in as needed. Paper mode works with empty keys.

# Alpaca (optional — paper endpoint by default)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# OpenAI (optional — only if llm.provider = openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama (on-device LLM — used when llm.provider = ollama or PI_INVEST_LOCAL_ONLY=true)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Non-cloud Pi mode: force Ollama + paper broker/wallet, disable cloud alerts
PI_INVEST_LOCAL_ONLY=false
# With local_only: allow Yahoo quotes (LLM still on-device)
PI_INVEST_ALLOW_ONLINE_QUOTES=false
# Desktop app on the Pi skips HTTP login for 127.0.0.1
PI_INVEST_DESKTOP_TRUST_LOOPBACK=true

# Must be true AND config broker.mode=live to place real orders
ALLOW_LIVE_TRADING=false

# Must be true to enable wallet.backend=coinbase (live withdrawals still gated in code)
# Coinbase App (CDP) — create at https://portal.cdp.coinbase.com/
# Use a Coinbase App API key with signature algorithm ECDSA (not Ed25519).
# Key name looks like: organizations/{org_id}/apiKeys/{key_id}
COINBASE_API_KEY=
# EC private key PEM. In .env you can keep it on one line with \n escapes:
# COINBASE_API_SECRET="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n"
COINBASE_API_SECRET=

# Required for live Coinbase sends (reads/balances work without this)
ALLOW_LIVE_TRANSFERS=false

# Dashboard HTTP basic auth (required when dashboard.require_auth=true)
DASHBOARD_USERNAME=pi
DASHBOARD_PASSWORD=change-me
# Optional read-only dashboard user (status/NAV only — no send/halt/cycle)
DASHBOARD_READONLY_USERNAME=viewer
DASHBOARD_READONLY_PASSWORD=

# Optional ntfy.sh push alerts (halt, resume, drawdown, Coinbase errors)
# Create a topic at https://ntfy.sh or self-host
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=

# Path overrides
PI_INVEST_CONFIG=config/config.yaml
PI_INVEST_DB=data/pi_invest.db
