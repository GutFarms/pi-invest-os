[Unit]
Description=Pi Invest Agent dashboard
After=network-online.target pi-invest.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Japan-central/pi-invest-agent
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/pi/Japan-central/pi-invest-agent/.env
ExecStart=/home/pi/Japan-central/pi-invest-agent/.venv/bin/pi-invest dashboard
Restart=on-failure
RestartSec=20

[Install]
WantedBy=multi-user.target
