# Pi Invest OS boot-partition secrets (FAT — editable from any computer).
# On first boot this file is copied to /opt/pi-invest-agent/.env
# Rename to pi-invest.env on the boot partition (already done by the image build).

# Dashboard HTTP basic auth
DASHBOARD_USERNAME=pi
DASHBOARD_PASSWORD=change-me
DASHBOARD_READONLY_USERNAME=viewer
DASHBOARD_READONLY_PASSWORD=

# Keep live trading / transfers locked until you intentionally unlock
ALLOW_LIVE_TRADING=false
ALLOW_LIVE_TRANSFERS=false

# Cloud brokers / OpenAI / Coinbase — leave blank. Local-only mode ignores these.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
OPENAI_API_KEY=
COINBASE_API_KEY=
COINBASE_API_SECRET=

# Optional ntfy push alerts (cloud — off by default for local-only)
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=

PI_INVEST_CONFIG=config/config.yaml
PI_INVEST_DB=data/pi_invest.db

# Non-cloud AI agent: decisions run on this Pi via Ollama (no OpenAI)
PI_INVEST_LOCAL_ONLY=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
PI_INVEST_OLLAMA_MODEL=llama3.2:3b

# Auto-update from GitHub — off so the agent stays self-contained on the Pi
PI_INVEST_AUTO_UPDATE=false
PI_INVEST_UPDATE_URL=https://github.com/GutFarms/Japan-central.git
# Image builds stamp /etc/pi-invest-os-update-branch; override here if needed
PI_INVEST_UPDATE_BRANCH=

# Local desktop app backend (loopback only — opened by Pi Invest app, not typed in a browser)
PI_INVEST_KIOSK_URL=http://127.0.0.1:8787
PI_INVEST_DESKTOP_TRUST_LOOPBACK=true
# Desktop environment on first boot (default). Set kiosk true for fullscreen-only.
PI_INVEST_DESKTOP=true
PI_INVEST_KIOSK=false
